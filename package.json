{
  "name": "amarportugal",
  "version": "1.1.0",
  "private": true,
  "description": "AmarPortugal EN/PT website with an Express, PostgreSQL and Prisma platform foundation.",
  "scripts": {
    "test": "node scripts/smoke-test.js && node --test scripts/workflow-rules.test.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "web:static": "node scripts/static-server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.0",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.0",
    "stripe": "^23.1.0",
    "zod": "^4.1.12"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  }
}
